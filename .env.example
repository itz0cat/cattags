# CatTags Backend Environment Configuration
PORT=8080
NODE_ENV=production
DATABASE_URL=postgresql://user:password@localhost:5432/cattags

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-replace-with-secure-random-value
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://cattags.xyz

# URLs
API_BASE_URL=https://cattags-api.onrender.com
WEB_BASE_URL=https://cattags.xyz

# S3-Compatible Object Storage (Optional: Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT=
STORAGE_BUCKET=cattags-logos
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
