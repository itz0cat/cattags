# CatTags Backend Environment Configuration
PORT=8080
NODE_ENV=production
DATABASE_URL=postgresql://user:password@localhost:5432/cattags

# Security & Authentication (MANDATORY: server will refuse startup if unset)
JWT_SECRET=super-secret-jwt-key-replace-with-secure-random-value-min-32-chars
BETTER_AUTH_SECRET=super-secret-better-auth-key-replace-with-secure-random-value
BETTER_AUTH_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://cattags.xyz

# Cloudflare Turnstile (Bot & Abuse Protection)
# For local testing, Cloudflare provides test keys:
# Sitekey: 1x00000000000000000000AA (always passes)
# Secret:  1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Resend Email Verification (Transactional Emails)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# URLs
API_BASE_URL=https://cattags-api.onrender.com
WEB_BASE_URL=https://cattags.xyz

# S3-Compatible Object Storage (Optional: Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT=
STORAGE_BUCKET=cattags-logos
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
